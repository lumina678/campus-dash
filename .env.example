# Copy this file to .env and replace every placeholder before starting the project.
MYSQL_ROOT_PASSWORD=replace-with-a-strong-database-password
DB_PASSWORD=replace-with-the-same-database-password
MYSQL_PASSWORD=replace-with-the-same-database-password
RELAY_AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
TEST_DB_PASSWORD=replace-with-the-test-database-password
TEST_JWT_SECRET=replace-with-a-random-test-secret-at-least-32-bytes
